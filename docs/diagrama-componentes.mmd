flowchart LR
  subgraph Usuarios
    A[Administrador<br/>Gestiona catálogo, festividades, usuarios,<br/>dashboard y recomendaciones]
    V[Vendedor<br/>Registra ventas y consulta<br/>productos e inventario]
  end

  subgraph Frontend["Frontend - React 18 + Vite + TypeScript"]
    ROUTER[React Router]
    AUTHCTX[AuthContext<br/>Guarda JWT y rol]
    VIEWS["Vistas: Login, Productos, Ventas,<br/>Inventario, Dashboard,<br/>Festividades, Recomendaciones, Usuarios"]
  end

  subgraph Backend["Backend - Python 3.11 + FastAPI + SQLAlchemy async"]
    API[app/main.py<br/>Mounts routers + error handlers]
    ROUTES["Routers: auth, users, products, categories,<br/>sales, inventory, holidays,<br/>ai_recommendations, reports"]
    SERVICES["Services: products, sales,<br/>inventory, holiday, daily_summary"]
    CORE["core: security (JWT+bcrypt),<br/>permissions (matriz de roles),<br/>stock_status, exceptions"]
    MODELS["SQLAlchemy async models:<br/>User, Product, Category, Sale,<br/>SaleItem, StockMovement, Holiday, Digitization"]
  end

  subgraph IA_ML["Servicios IA/ML (app/services/ai)"]
    SEG[segmentation<br/>Clustering RFM - scikit-learn]
    REC[recommendations<br/>Producto, cantidad y motivo]
    HENG[holiday_engine<br/>Factor de demanda por festividad]
    NL[natural_language<br/>Explicación en lenguaje natural]
    VIEW[digitizer / vision y utilidades<br/>scikit-learn + pandas + numpy]
  end

  LLM_API["API IA Generativa<br/>(openai - LLM)"]

  subgraph Datos["Datos"]
    DB[("PostgreSQL 16<br/>asyncpg")]
  end

  subgraph Dev
    TEST[Pytest - test_api, test_critical_flows]
    SEED[app/seed.py - datos iniciales]
    TRAIN[scripts/train_segmenter.py<br/>Reentrenamiento del modelo]
  end

  A -->|Usa| VIEWS
  V -->|Usa| VIEWS
  VIEWS --> ROUTER
  ROUTER --> AUTHCTX
  AUTHCTX -->|Llamadas REST/JSON| API
  API --> ROUTES
  ROUTES --> SERVICES
  SERVICES --> CORE
  SERVICES --> MODELS
  MODELS -->|asyncpg| DB
  API -->|Solicita recomendaciones| REC
  REC --> SEG
  REC --> HENG
  REC --> NL
  NL -->|Genera explicación natural| LLM_API
  SEG -->|Entrena/carga modelo| TRAIN
  TRAIN -->|Lee histórico de ventas| DB
  API -->|Sirve dashboard/resúmenes| SERVICES
  SERVICES --> TEST
  SEED -->|Pobla catálogo y usuarios| DB